{
  "metadata": {
    "name": "Gemini Translate",
    "author": "vBook",
    "version": 4,
    "source": "https://ai.google.dev",
    "description": "Dịch nội dung bằng Google Gemini API",
    "locale": "global",
    "regexp": "",
    "type": "translate",
    "nsfw": false,
    "encrypt": false
  },
  "script": {
    "config": "config.js",
    "action": "action.js",
    "language": "language.js",
    "model": "model.js",
    "style": "style.js",
    "translate": "translate.js"
  },
  "config": {
    "support_auto_detect": {
      "title": "Tự động nhận diện ngôn ngữ",
      "default": "true",
