      "format": "number"
    },
    "max_length": {
      "title": "Số ký tự tối đa mỗi yêu cầu",
      "default": "12000",
      "mode": "input",
      "format": "number"
    },
    "support_url": "https://aistudio.google.com/app/apikey"
  }
}
