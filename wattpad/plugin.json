{
  "metadata": {
    "name": "Wattpad",
    "author": "vBook",
    "version": 4,
    "source": "https://www.wattpad.com",
    "regexp": "(www\\.)?wattpad\\.com/story/\\d+.*",
    "description": "Đọc truyện trên trang Wattpad",
    "locale": "global",
    "language": "javascript",
    "type": "novel",
    "encrypt": true
  },
  "config": {
    "DOMAIN": {
      "title": "Domain",
      "default": "https://www.wattpad.com",
      "mode": "input",
      "format": "text"
    },
    "LANGUAGE": {
      "title": "Ngôn ngữ tìm kiếm",
      "mode": "select",
      "default": "Tiếng Việt",
      "values": [
        "Tiếng Việt",
        "English",
        "简体中文",
        "繁體中文",
        "日本語",
        "한국어",
        "Bahasa Indonesia",
        "ภาษาไทย",
        "Filipino",
        "Español",
        "Français",
        "Deutsch",
        "Português",
        "Русский"
      ]
    }
  },
  "script": {
    "home": "home.js",
    "detail": "detail.js",
    "search": "search.js",
    "toc": "toc.js",
    "chap": "chap.js"
  }
}
