    "nsfw": false,
    "encrypt": true
  },
  "script": {
    "explore": "explore.js",
    "genre": "genre.js",
    "search": "search.js",
    "detail": "detail.js",
    "toc": "toc.js",
    "chap": "chap.js",
    "track": "track.js"
  },
  "config": {
    "DOMAIN": {
      "title": "Domain",
      "default": "https://www.shorttv.live",
      "mode": "input",
      "format": "text"
