    "regexp": "(https?://)?(www\\.)?shorttv\\.live/vi/(?:drama|episodes)/[^/?#]*\\d+/?|(https?://)?(www\\.)?shorttv\\.live/vi/episode/[^/?#]*\\d+-\\d+/?",
